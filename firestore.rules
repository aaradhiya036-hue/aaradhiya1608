rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /letters/{id} {
   allow create: if request.resource.data.keys().hasOnly(["name","message","anonymous","createdAt"])
    && request.resource.data.name is string && request.resource.data.name.size() <= 80
    && request.resource.data.message is string && request.resource.data.message.size() >= 5
    && request.resource.data.message.size() <= 5000 && request.resource.data.anonymous is bool;
   allow read, update, delete: if false;
  }
 }
}